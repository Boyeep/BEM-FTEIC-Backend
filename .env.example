APP_ENV=production
GIN_MODE=release
PORT=8080

# Use the Supabase direct connection for migrations or the session pooler for
# the long-running API. Percent-encode special characters in the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres?sslmode=require

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=replace_with_supabase_anon_key

ALLOWED_ORIGINS=https://bem-fteic.com,https://www.bem-fteic.com
PUBLIC_API_URL=https://api.bem-fteic.com
